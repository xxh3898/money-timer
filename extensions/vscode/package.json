{
  "name": "money-timer",
  "displayName": "Money Timer",
  "description": "Track real-time take-home earnings in the VS Code status bar. All data stays local.",
  "version": "0.3.1",
  "publisher": "xxh3898",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/xxh3898/money-timer.git"
  },
  "bugs": {
    "url": "https://github.com/xxh3898/money-timer/issues"
  },
  "homepage": "https://github.com/xxh3898/money-timer#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "keywords": ["salary", "earnings", "timer", "productivity", "status-bar"],
  "icon": "assets/icon.png",
  "galleryBanner": {
    "color": "#0B3CC1",
    "theme": "dark"
  },
  "pricing": "Free",
  "preview": true,
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      { "command": "moneyTimer.configure", "title": "Money Timer: Configure" },
      { "command": "moneyTimer.toggleVisibility", "title": "Money Timer: Toggle Visibility" },
      { "command": "moneyTimer.showDetails", "title": "Money Timer: Show Details" },
      { "command": "moneyTimer.manageGoals", "title": "Money Timer: Manage Goals" },
      { "command": "moneyTimer.calculateLaborTime", "title": "Money Timer: Calculate Labor Time" },
      { "command": "moneyTimer.resetSettings", "title": "Money Timer: Reset Settings" }
    ],
    "configuration": {
      "title": "Money Timer",
      "properties": {
        "moneyTimer.position": {
          "type": "string", "scope": "application", "enum": ["left", "right"], "default": "right",
          "enumDescriptions": ["상태 표시줄 왼쪽에 표시합니다.", "상태 표시줄 오른쪽에 표시합니다."],
          "description": "Money Timer 표시 위치. 기존 급여 설정과 표시 여부를 유지한 채 바로 적용합니다."
        }
      }
    }
  },
  "vsce": {
    "baseContentUrl": "https://github.com/xxh3898/money-timer/blob/main/extensions/vscode",
    "baseImagesUrl": "https://raw.githubusercontent.com/xxh3898/money-timer/main/extensions/vscode"
  },
  "scripts": {
    "dev": "code --extensionDevelopmentPath=.",
    "test": "node --test test/extension.test.cjs",
    "package": "vsce package --no-dependencies --out money-timer-0.3.1.vsix"
  },
  "devDependencies": {
    "@vscode/vsce": "^2.15.0"
  }
}
