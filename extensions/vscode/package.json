{
  "name": "money-timer-vscode",
  "displayName": "Money Timer",
  "description": "Show real-time Money Timer earnings in the VS Code status bar.",
  "version": "0.1.0",
  "publisher": "xxh3898",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:moneyTimer.configure",
    "onCommand:moneyTimer.toggleVisibility",
    "onCommand:moneyTimer.showDetails",
    "onCommand:moneyTimer.resetSettings"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      { "command": "moneyTimer.configure", "title": "Money Timer: Configure" },
      { "command": "moneyTimer.toggleVisibility", "title": "Money Timer: Toggle Visibility" },
      { "command": "moneyTimer.showDetails", "title": "Money Timer: Show Details" },
      { "command": "moneyTimer.resetSettings", "title": "Money Timer: Reset Settings" }
    ]
  },
  "scripts": {
    "dev": "code --extensionDevelopmentPath=.",
    "package": "vsce package"
  },
  "devDependencies": {
    "@vscode/vsce": "^2.15.0"
  }
}
